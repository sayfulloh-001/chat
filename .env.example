# ==========================================
# NEXUS ENTERPRISE PLATFORM ENVIRONMENT CONFIG
# ==========================================

# SERVER & APPLICATION CONFIG
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# DATABASE CONFIGURATION
# SQLite for instant zero-dependency setup out-of-the-box, or PostgreSQL for Production
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL for Production:
# DATABASE_URL="postgresql://nexus_user:nexus_password_2026@localhost:5432/nexus_db?schema=public"

# AUTHENTICATION & SECURITY
JWT_SECRET=nexus_super_secret_jwt_access_token_key_2026_xyz
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=nexus_super_secret_jwt_refresh_token_key_2026_abc
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=nexus_cookie_secure_signature_key_2026

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# FILE UPLOAD CONFIG
MAX_FILE_SIZE=52428800 # 50 MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CLOUDINARY (OPTIONAL CLOUD STORAGE ADAPTER)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# REDIS (OPTIONAL CACHING / SOCKET CONNECTIONS)
REDIS_URL=redis://localhost:6379

# NEXT.JS PUBLIC ENVS FOR FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME="Nexus Enterprise"
